# Copy to .env.local (gitignored).
# mock = in-browser simulator, no worker needed (default for `pnpm dev`).
# http = the worker in apps/worker (default for production builds).
VITE_API_MODE=http
# http mode only: the car the "Check in" button taps when there is no NFC tag to hand.
# Matches DEMO_CAR_TRIPS in apps/worker/wrangler.toml. Leave unset in production.
VITE_DEMO_CAR=1412
