// phone-web TypeScript config. Strict, with DOM libs, the React JSX transform and Vite's
// client types. It does not extend tsconfig.base.json yet: the screens were written without
// noUncheckedIndexedAccess. vite.config.ts is not typechecked here.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "shared"]
}
