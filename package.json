{
  "name": "questline",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:worker": "pnpm --filter @questline/worker dev",
    "dev:phone": "pnpm --filter @questline/phone-web dev",
    "dev:glasses": "pnpm --filter @questline/glasses-web dev",
    "dev:kiosk": "pnpm --filter @questline/kiosk-web dev",
    "dev:start": "pnpm --filter @questline/start-screen dev",
    "build": "pnpm -r --filter \"./apps/*-web\" build && node scripts/build-assets.mjs",
    "deploy": "pnpm build && pnpm --filter @questline/worker run deploy",
    "typecheck": "pnpm -r typecheck",
    "db:migrate:local": "pnpm --filter @questline/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @questline/worker db:migrate:remote",
    "seed": "tsx scripts/seed.ts",
    "ghosts": "tsx scripts/ghost-riders.ts",
    "smoke": "tsx scripts/smoke.ts",
    "art": "pnpm --filter @questline/start-screen art"
  },
  "devDependencies": {
    "@questline/protocol": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
